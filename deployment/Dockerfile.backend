# 后端 Dockerfile
# 多阶段构建以减小镜像体积
#
# 基镜像说明：使用 Debian 版（非 alpine 变体）。国内镜像加速器对冷门的
# alpine 变体标签无法回源拉取（unknown error / blob TLS 超时），
# Debian 版为热门标签可直接拉取；wget/curl 由基镜像自带。

# 阶段1: 构建阶段
FROM maven:3.9-eclipse-temurin-17 AS builder

WORKDIR /app

# Maven 依赖走阿里云公共仓库（服务器直连 Maven Central 较慢）
COPY settings-aliyun.xml /root/.m2/settings.xml

# 复制 pom.xml 并下载依赖（利用 Docker 缓存）
COPY pom.xml .
RUN mvn dependency:go-offline -B

# 复制源代码
COPY src ./src

# 构建应用
RUN mvn clean package -DskipTests -B

# 阶段2: 运行阶段
FROM eclipse-temurin:17-jre

# 添加非 root 用户以提高安全性（Debian 语法，无 -S 短选项）
RUN groupadd -r spring && useradd -r -g spring spring
USER spring:spring

WORKDIR /app

# 从构建阶段复制 JAR 文件
COPY --from=builder /app/target/pet-shop-backend-*.jar app.jar

# 创建上传目录
RUN mkdir -p /app/uploads/images

# 暴露端口
EXPOSE 8080

# 健康检查（探测 Tomcat 端口可达即可；Debian 基镜像自带 wget）
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD wget -q -O /dev/null http://localhost:8080/ || exit 1

# 启动应用
ENTRYPOINT ["java", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-Dspring.profiles.active=production", \
  "-jar", \
  "app.jar"]
