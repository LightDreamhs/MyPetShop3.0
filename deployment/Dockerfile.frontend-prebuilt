# 前端镜像（预构建版）
# 适用场景：低内存服务器（如 2GB 双店共用机）上避免在服务器跑 npm 构建。
# 用法：先在开发机 `npm run build` 产出 dist/，再以 frontend/ 为构建上下文：
#   docker build -t <tag> -f deployment/Dockerfile.frontend-prebuilt frontend/
# 运行阶段与 frontend/Dockerfile 完全一致，仅将多阶段构建的 dist 来源
# 从"容器内 npm 构建"换为"开发机预构建产物"。

FROM nginx:alpine

# 安装 wget 用于健康检查
RUN apk add --no-cache wget

# 添加非 root 用户以提高安全性
RUN addgroup -S nginx-user && adduser -S nginx-user -G nginx-user

# 复制开发机预构建的产物
COPY dist /usr/share/nginx/html

# 复制 Nginx 配置
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 设置权限
RUN chown -R nginx-user:nginx-user /usr/share/nginx/html && \
    chown -R nginx-user:nginx-user /var/cache/nginx && \
    chown -R nginx-user:nginx-user /var/log/nginx && \
    chown -R nginx-user:nginx-user /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R nginx-user:nginx-user /var/run/nginx.pid

# 切换到非 root 用户
USER nginx-user

# 暴露端口
EXPOSE 80

# 启动 Nginx（前台运行）
CMD ["nginx", "-g", "daemon off;"]
